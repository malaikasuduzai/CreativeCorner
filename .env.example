# ============================================================
# Creative Corner - environment variables
# Copy this file to ".env" in the project root and fill in real values.
# Never commit the real .env file to GitHub.
# ============================================================

# --- Database (MySQL, used by Prisma) ---
DATABASE_URL="mysql://root:your_password@localhost:3306/creative_corner"

# --- Admin login sessions ---
JWT_SECRET="replace-with-a-long-random-secret"

# --- Email (Nodemailer + Gmail) ---
# Use a Google App Password (Google Account > Security > 2-Step Verification > App passwords)

GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
# Sender address shown on emails (falls back to GMAIL_USER if empty)
EMAIL_FROM="Creative Corner <your-email@gmail.com>"

# --- App URL ---
# Base URL used in links such as the admin password-reset email.
# Use your real domain in production, e.g. https://www.yourdomain.com
APP_URL="http://localhost:3000"


